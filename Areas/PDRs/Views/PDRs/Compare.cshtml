@{
    string GetStatusBadgeClass(InfoPoint.Models.PDRStatus status)
    {
        return status switch
        {
            InfoPoint.Models.PDRStatus.Assigned => "primary",
            InfoPoint.Models.PDRStatus.StaffCompleted => "warning",
            InfoPoint.Models.PDRStatus.ManagerCompleted => "info",
            InfoPoint.Models.PDRStatus.ReadyForCollaboration => "success",
            InfoPoint.Models.PDRStatus.Completed => "dark",
            _ => "secondary"
        };
    }

    string GetStatusDisplayName(InfoPoint.Models.PDRStatus status)
    {
        return status switch
        {
            InfoPoint.Models.PDRStatus.Assigned => "Assigned",
            InfoPoint.Models.PDRStatus.StaffCompleted => "Staff Completed",
            InfoPoint.Models.PDRStatus.ManagerCompleted => "Manager Completed",
            InfoPoint.Models.PDRStatus.ReadyForCollaboration => "Ready for Collaboration",
            InfoPoint.Models.PDRStatus.Completed => "Completed",
            _ => "Unknown"
        };
    }
}