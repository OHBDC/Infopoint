@model InfoPoint.Areas.PDRs.Controllers.PDRComparisonViewModel
@{
    ViewData["Title"] = $"PDR Collaboration - {Model.PDR.Staff.FullName} ({Model.PDR.Year})";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard" asp-area="">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="PDRs" asp-action="Index">PDRs</a></li>
        <li class="breadcrumb-item active" aria-current="page">PDR Collaboration</li>
    </ol>
</nav>

<div class="container">
    <!-- Subtle progress indicator at top -->
    <div class="progress-indicator-container">
        <div class="progress-indicator">
            <div class="progress-bar-subtle" id="progressBar" style="width: 0%"></div>
        </div>
        <div class="progress-info">
            <span class="progress-text" id="progressText">Question 1 of @Model.Comparisons.Count()</span>
            <div class="pdr-info">
                <span class="staff-name">@Model.PDR.Staff.FullName</span>
                <span class="pdr-details">@Model.PDR.Year Collaboration</span>
            </div>
        </div>
    </div>
    
    <h1 class="page-title">PDR Collaboration</h1>

    @if (Model.PDR.Status != InfoPoint.Models.PDRStatus.Completed)
    {
        <div class="alert alert-info mb-4">
            <h6><i class="bi bi-people me-2"></i>Collaborative Session</h6>
            <p class="mb-0">
                Focus on areas needing discussion (ratings of 3 or below). Click <strong>"Add Response"</strong> to document collaborative discussions and agreed actions. Items where both parties rated 4-5 stars are marked as positive and don't require a response unless you want to add one.
            </p>
        </div>
    }

    <form id="collaborativeForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="pdrId" value="@Model.PDR.Id" />
        
        <!-- Comparison Table -->
        <div class="comparison-table-container">
            @{
                var allComparisons = Model.Comparisons.OrderBy(c => c.Question.Category).ThenBy(c => c.Question.Order).ToList();
                string currentCategory = "";
            }
            
            <div class="table-responsive">
                <table class="table comparison-table">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Question</th>
                            <th style="width: 25%;">Staff Response</th>
                            <th style="width: 25%;">Manager Response</th>
                            <th style="width: 25%;">Collaborative Response</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comparison in allComparisons)
                        {
                            @if (currentCategory != comparison.Question.Category)
                            {
                                currentCategory = comparison.Question.Category;
                                <tr class="category-row">
                                    <td colspan="4" class="category-header">
                                        <h5 class="category-title-table">
                                            <i class="bi bi-folder2-open me-2"></i>@currentCategory
                                        </h5>
                                    </td>
                                </tr>
                            }
                            
                            // Parse staff response
                            var staffPillMatch = System.Text.RegularExpressions.Regex.Match(comparison.StaffResponse ?? "", @"Selected feedback: (.*?)(?:\n|$)");
                            var staffCommentMatch = System.Text.RegularExpressions.Regex.Match(comparison.StaffResponse ?? "", @"Additional comment: (.*)");
                            string staffPillText = staffPillMatch.Success ? staffPillMatch.Groups[1].Value : "";
                            string staffCommentText = staffCommentMatch.Success ? staffCommentMatch.Groups[1].Value : "";
                            
                            // Parse manager response  
                            var managerPillMatch = System.Text.RegularExpressions.Regex.Match(comparison.ManagerResponse ?? "", @"Selected feedback: (.*?)(?:\n|$)");
                            var managerCommentMatch = System.Text.RegularExpressions.Regex.Match(comparison.ManagerResponse ?? "", @"Additional comment: (.*)");
                            string managerPillText = managerPillMatch.Success ? managerPillMatch.Groups[1].Value : "";
                            string managerCommentText = managerCommentMatch.Success ? managerCommentMatch.Groups[1].Value : "";
                            
                            // New logic: Check if response is needed based on ratings
                            int staffRating = comparison.StaffRating ?? 0;
                            int managerRating = comparison.ManagerRating ?? 0;

                            // Requires discussion if either rating is 3 or below
                            bool requiresDiscussion = staffRating <= 3 || managerRating <= 3;

                            // Both positive (both > 3) - no response needed even if different
                            bool bothPositive = staffRating > 3 && managerRating > 3;

                            // Check for text differences
                            bool hasTextDifferences = !string.Equals(staffPillText.Trim(), managerPillText.Trim(), StringComparison.OrdinalIgnoreCase);

                            bool hasCollaborativeResponse = comparison.CollaborativeRating.HasValue || !string.IsNullOrEmpty(comparison.CollaborativeResponse);

                            string rowClass = "";
                            if (Model.PDR.Status != InfoPoint.Models.PDRStatus.Completed)
                            {
                                if (hasCollaborativeResponse)
                                    rowClass = "row-completed";
                                else if (requiresDiscussion)
                                    rowClass = "row-needs-discussion"; // Red/amber for low ratings
                                else if (bothPositive)
                                    rowClass = "row-agreement"; // Green for both positive
                                else
                                    rowClass = "row-neutral";
                            }
                            
                            <tr class="comparison-row @rowClass" data-question-id="@comparison.QuestionId" data-requires-discussion="@requiresDiscussion.ToString().ToLower()">
                                <!-- Question Column -->
                                <td class="question-cell">
                                    <div class="question-content">
                                        <strong>@comparison.Question.StaffQuestionText</strong>
                                        @if (!string.IsNullOrEmpty(comparison.Question.Description))
                                        {
                                            <small class="text-muted d-block mt-1">@comparison.Question.Description</small>
                                        }
                                    </div>
                                </td>
                                
                                <!-- Staff Response Column -->
                                <td class="response-cell staff-cell">
                                    <div class="response-content-table">
                                        @if (comparison.StaffRating.HasValue)
                                        {
                                            <div class="rating-display">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <span class="star-tiny @(i <= comparison.StaffRating.Value ? "active" : "")">★</span>
                                                }
                                                <span class="rating-text">(@comparison.StaffRating.Value/5)</span>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(staffPillText))
                                        {
                                            var staffPills = staffPillText.Split(',').Select(p => p.Trim()).Where(p => !string.IsNullOrEmpty(p)).ToList();
                                            <div class="pills-compact truncatable">
                                                <div class="truncate-content @(staffPills.Count > 1 ? "truncated" : "")">
                                                    @foreach (string pill in staffPills)
                                                    {
                                                        <span class="pill-compact staff-pill">@pill</span>
                                                    }
                                                </div>
                                                @if (staffPills.Count > 1)
                                                {
                                                    <button class="btn-see-more" type="button">
                                                        <span class="see-more-text"><i class="bi bi-chevron-down"></i> See More</span>
                                                        <span class="see-less-text" style="display: none;"><i class="bi bi-chevron-up"></i> See Less</span>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(staffCommentText))
                                        {
                                            <div class="comment-compact truncatable">
                                                <div class="truncate-content @(staffCommentText.Length > 50 ? "truncated" : "")">
                                                    <em>@staffCommentText</em>
                                                </div>
                                                @if (staffCommentText.Length > 50)
                                                {
                                                    <button class="btn-see-more" type="button">
                                                        <span class="see-more-text"><i class="bi bi-chevron-down"></i> See More</span>
                                                        <span class="see-less-text" style="display: none;"><i class="bi bi-chevron-up"></i> See Less</span>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        @if (string.IsNullOrEmpty(comparison.StaffResponse))
                                        {
                                            <em class="text-muted">No response</em>
                                        }
                                        else if (string.IsNullOrEmpty(staffPillText) && string.IsNullOrEmpty(staffCommentText))
                                        {
                                            <div class="legacy-response truncatable">
                                                <div class="truncate-content @(comparison.StaffResponse.Length > 50 ? "truncated" : "")">
                                                    @comparison.StaffResponse
                                                </div>
                                                @if (comparison.StaffResponse.Length > 50)
                                                {
                                                    <button class="btn-see-more" type="button">
                                                        <span class="see-more-text"><i class="bi bi-chevron-down"></i> See More</span>
                                                        <span class="see-less-text" style="display: none;"><i class="bi bi-chevron-up"></i> See Less</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                                
                                <!-- Manager Response Column -->
                                <td class="response-cell manager-cell">
                                    <div class="response-content-table">
                                        @if (comparison.ManagerRating.HasValue)
                                        {
                                            <div class="rating-display">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <span class="star-tiny @(i <= comparison.ManagerRating.Value ? "active" : "")">★</span>
                                                }
                                                <span class="rating-text">(@comparison.ManagerRating.Value/5)</span>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(managerPillText))
                                        {
                                            var managerPills = managerPillText.Split(',').Select(p => p.Trim()).Where(p => !string.IsNullOrEmpty(p)).ToList();
                                            <div class="pills-compact truncatable">
                                                <div class="truncate-content @(managerPills.Count > 1 ? "truncated" : "")">
                                                    @foreach (string pill in managerPills)
                                                    {
                                                        <span class="pill-compact manager-pill">@pill</span>
                                                    }
                                                </div>
                                                @if (managerPills.Count > 1)
                                                {
                                                    <button class="btn-see-more" type="button">
                                                        <span class="see-more-text"><i class="bi bi-chevron-down"></i> See More</span>
                                                        <span class="see-less-text" style="display: none;"><i class="bi bi-chevron-up"></i> See Less</span>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(managerCommentText))
                                        {
                                            <div class="comment-compact truncatable">
                                                <div class="truncate-content @(managerCommentText.Length > 50 ? "truncated" : "")">
                                                    <em>@managerCommentText</em>
                                                </div>
                                                @if (managerCommentText.Length > 50)
                                                {
                                                    <button class="btn-see-more" type="button">
                                                        <span class="see-more-text"><i class="bi bi-chevron-down"></i> See More</span>
                                                        <span class="see-less-text" style="display: none;"><i class="bi bi-chevron-up"></i> See Less</span>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        @if (string.IsNullOrEmpty(comparison.ManagerResponse))
                                        {
                                            <em class="text-muted">No response</em>
                                        }
                                        else if (string.IsNullOrEmpty(managerPillText) && string.IsNullOrEmpty(managerCommentText))
                                        {
                                            <div class="legacy-response truncatable">
                                                <div class="truncate-content @(comparison.ManagerResponse.Length > 50 ? "truncated" : "")">
                                                    @comparison.ManagerResponse
                                                </div>
                                                @if (comparison.ManagerResponse.Length > 50)
                                                {
                                                    <button class="btn-see-more" type="button">
                                                        <span class="see-more-text"><i class="bi bi-chevron-down"></i> See More</span>
                                                        <span class="see-less-text" style="display: none;"><i class="bi bi-chevron-up"></i> See Less</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                                
                                <!-- Collaborative Response Column -->
                                <td class="response-cell collab-cell">
                                    @if (Model.PDR.Status != InfoPoint.Models.PDRStatus.Completed)
                                    {
                                        @if (hasCollaborativeResponse)
                                        {
                                            <div class="collab-response-display">
                                                @if (comparison.CollaborativeRating.HasValue)
                                                {
                                                    <div class="rating-display">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <span class="star-tiny @(i <= comparison.CollaborativeRating.Value ? "active" : "")">★</span>
                                                        }
                                                        <span class="rating-text">(@comparison.CollaborativeRating.Value/5)</span>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrEmpty(comparison.CollaborativeResponse))
                                                {
                                                    <div class="collab-text">@comparison.CollaborativeResponse</div>
                                                }

                                                <button type="button" class="btn btn-sm btn-outline-primary mt-2 edit-collab-btn" data-question-id="@comparison.QuestionId">
                                                    <i class="bi bi-pencil me-1"></i>Edit
                                                </button>
                                            </div>
                                        }
                                        else if (requiresDiscussion)
                                        {
                                            <button type="button" class="btn btn-warning btn-sm add-response-btn" data-question-id="@comparison.QuestionId">
                                                <i class="bi bi-chat-dots me-1"></i>Add Response
                                            </button>
                                        }
                                        else if (bothPositive)
                                        {
                                            <div class="agreement-status">
                                                <i class="bi bi-check-circle text-success me-1"></i>
                                                <span class="text-success">Both Positive</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="neutral-status">
                                                <i class="bi bi-dash-circle text-muted me-1"></i>
                                                <span class="text-muted">No response needed</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <!-- View-only for completed PDRs -->
                                        <div class="collab-response-final">
                                            @if (comparison.CollaborativeRating.HasValue)
                                            {
                                                <div class="rating-display">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <span class="star-tiny @(i <= comparison.CollaborativeRating.Value ? "active" : "")">★</span>
                                                    }
                                                    <span class="rating-text">(@comparison.CollaborativeRating.Value/5)</span>
                                                </div>
                                            }
                                            
                                            @if (!string.IsNullOrEmpty(comparison.CollaborativeResponse))
                                            {
                                                <div class="collab-text">@comparison.CollaborativeResponse</div>
                                            }
                                            else
                                            {
                                                <em class="text-muted">No collaborative response</em>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        @if (Model.PDR.Status != InfoPoint.Models.PDRStatus.Completed)
        {
            <!-- Smart Targets Section -->
            <div class="smart-targets-section mt-5">
                <div class="section-header">
                    <h3 class="section-title">
                        <i class="bi bi-target me-2"></i>SMART Targets
                    </h3>
                    <p class="section-subtitle">Set targets for @Model.PDR.Staff.FullName</p>
                    <div class="smart-definition">
                        <small class="text-muted">
                            <strong>S</strong>pecific • <strong>M</strong>easurable • <strong>A</strong>chievable • <strong>R</strong>elevant • <strong>T</strong>ime-bound
                        </small>
                    </div>
                </div>
                
                <div id="smartTargetsContainer" class="smart-targets-container">
                    <!-- Smart targets will be dynamically added here -->
                </div>
                
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-outline-primary" id="addSmartTargetBtn">
                        <i class="bi bi-plus-circle me-2"></i>Add SMART Target
                    </button>
                </div>
                
                <div class="alert alert-info mt-3" id="smartTargetRequirement">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Minimum 2 SMART targets</strong> must be set before finalizing the PDR.
                </div>
            </div>
            
            <div class="text-center mt-4">
                <button type="button" class="btn btn-success btn-lg" id="completeCollaborativeBtn">
                    <i class="bi bi-check-circle me-2"></i>Finalize PDR
                </button>
            </div>
        }
        else
        {
            <div class="text-center mt-4">
                <a asp-controller="PDRs" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Back to PDRs
                </a>
            </div>
        }
    </form>
</div>

<!-- Collaborative Response Modal -->
<div class="modal fade" id="collabModal" tabindex="-1" aria-labelledby="collabModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="collabModalLabel">
                    <i class="bi bi-people me-2"></i>Create Collaborative Response
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalQuestionText" class="question-display mb-4"></div>
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6><i class="bi bi-person-circle me-2"></i>Staff Response</h6>
                        <div id="modalStaffResponse" class="response-preview staff-preview"></div>
                    </div>
                    <div class="col-md-6">
                        <h6><i class="bi bi-person-badge me-2"></i>Manager Response</h6>
                        <div id="modalManagerResponse" class="response-preview manager-preview"></div>
                    </div>
                </div>
                
                <div class="collaborative-input-section">
                    <h6><i class="bi bi-people me-2"></i>Collaborative Response</h6>
                    
                    <div class="rating-input mb-3">
                        <label class="form-label">Agreed Rating</label>
                        <div class="star-rating-input" id="modalStarRating">
                            <span class="star-input" data-value="1">★</span>
                            <span class="star-input" data-value="2">★</span>
                            <span class="star-input" data-value="3">★</span>
                            <span class="star-input" data-value="4">★</span>
                            <span class="star-input" data-value="5">★</span>
                        </div>
                        <small class="form-text text-muted">Select the agreed rating for this question</small>
                    </div>
                    
                    <div class="response-input mb-3">
                        <label class="form-label">Collaborative Response</label>
                        <textarea id="modalCollabResponse" class="form-control" rows="5" placeholder="Enter the agreed-upon response..."></textarea>
                        <small class="form-text text-muted">Describe the agreed response based on the discussion</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveCollabResponseBtn">
                    <i class="bi bi-check-circle me-1"></i>Save Response
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const pdrId = document.getElementById('pdrId').value;
    let currentQuestionId = null;
    let modalStarRating = 0;
    
    // Initialize
    initializeTableInteractions();
    initializeModal();
    initializeSeeMoreButtons();
    
    // Enhancement confirmation dialog function
    function showEnhancementConfirmation(originalText, enhancedText, callback) {
        const modal = document.getElementById('enhancementModal');
        if (!modal) {
            // Create modal if it doesn't exist
            const modalHtml = `
                <div class="modal fade" id="enhancementModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    <i class="bi bi-magic me-2"></i>AI Enhancement Preview
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="enhancement-comparison">
                                    <div class="original-target mb-3">
                                        <h6 class="text-muted">Original Target:</h6>
                                        <div class="target-content" id="originalTargetContent"></div>
                                    </div>
                                    <div class="enhanced-target">
                                        <h6 class="text-success">Enhanced SMART Target:</h6>
                                        <div class="target-content enhanced" id="enhancedTargetContent"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </button>
                                <button type="button" class="btn btn-primary" id="confirmEnhancementBtn">
                                    <i class="bi bi-check-circle me-1"></i>Apply Enhancement
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }
        
        // Update content
        document.getElementById('originalTargetContent').textContent = originalText;
        document.getElementById('enhancedTargetContent').textContent = enhancedText;
        
        // Show modal
        const enhancementModal = new bootstrap.Modal(document.getElementById('enhancementModal'));
        enhancementModal.show();
        
        // Handle confirmation
        const confirmBtn = document.getElementById('confirmEnhancementBtn');
        const newConfirmBtn = confirmBtn.cloneNode(true);
        confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
        
        newConfirmBtn.addEventListener('click', function() {
            enhancementModal.hide();
            callback(true);
        });
        
        // Handle modal hidden event
        document.getElementById('enhancementModal').addEventListener('hidden.bs.modal', function() {
            callback(false);
        }, { once: true });
    }
    
    function initializeTableInteractions() {
        // Handle add response buttons (for low ratings)
        document.querySelectorAll('.add-response-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const questionId = this.dataset.questionId;
                openCollabModal(questionId);
            });
        });

        // Handle edit response buttons
        document.querySelectorAll('.edit-collab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const questionId = this.dataset.questionId;
                openCollabModal(questionId, true); // true = editing existing
            });
        });
    }

    function initializeSeeMoreButtons() {
        document.querySelectorAll('.btn-see-more').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const container = this.closest('.truncatable');
                const content = container.querySelector('.truncate-content');
                const seeMoreText = this.querySelector('.see-more-text');
                const seeLessText = this.querySelector('.see-less-text');

                if (content.classList.contains('truncated')) {
                    // Expand
                    content.classList.remove('truncated');
                    content.classList.add('expanded');
                    seeMoreText.style.display = 'none';
                    seeLessText.style.display = 'inline';
                } else {
                    // Collapse
                    content.classList.add('truncated');
                    content.classList.remove('expanded');
                    seeMoreText.style.display = 'inline';
                    seeLessText.style.display = 'none';
                }
            });
        });
    }

    function openCollabModal(questionId, isEditing = false) {
        currentQuestionId = questionId;
        const modal = new bootstrap.Modal(document.getElementById('collabModal'));
        
        // Find the row data
        const row = document.querySelector(`tr[data-question-id="${questionId}"]`);
        const questionText = row.querySelector('.question-content strong').textContent;
        const staffContent = row.querySelector('.staff-cell .response-content-table').innerHTML;
        const managerContent = row.querySelector('.manager-cell .response-content-table').innerHTML;
        
        // Populate modal
        document.getElementById('modalQuestionText').innerHTML = `<strong>${questionText}</strong>`;
        document.getElementById('modalStaffResponse').innerHTML = staffContent;
        document.getElementById('modalManagerResponse').innerHTML = managerContent;
        
        // Clear or populate existing collaborative response
        if (isEditing) {
            const existingRating = row.querySelector('.collab-response-display .rating-display .rating-text');
            const existingText = row.querySelector('.collab-response-display .collab-text');
            
            if (existingRating) {
                const rating = parseInt(existingRating.textContent.match(/\((\d+)\/5\)/)?.[1] || 0);
                setModalStarRating(rating);
            }
            
            if (existingText) {
                document.getElementById('modalCollabResponse').value = existingText.textContent;
            }
            
            document.getElementById('collabModalLabel').innerHTML = 
                '<i class="bi bi-pencil me-2"></i>Edit Collaborative Response';
        } else {
            setModalStarRating(0);
            document.getElementById('modalCollabResponse').value = '';
            document.getElementById('collabModalLabel').innerHTML = 
                '<i class="bi bi-people me-2"></i>Create Collaborative Response';
        }
        
        modal.show();
    }
    
    function initializeModal() {
        // Initialize star rating in modal
        document.querySelectorAll('#modalStarRating .star-input').forEach((star, index) => {
            const rating = index + 1;
            
            star.addEventListener('mouseenter', () => {
                highlightModalStars(rating);
            });
            
            star.addEventListener('mouseleave', () => {
                highlightModalStars(modalStarRating);
            });
            
            star.addEventListener('click', () => {
                setModalStarRating(rating);
            });
        });
        
        // Save button
        document.getElementById('saveCollabResponseBtn').addEventListener('click', function() {
            saveCollaborativeResponse();
        });
    }
    
    function setModalStarRating(rating) {
        modalStarRating = rating;
        highlightModalStars(rating);
    }
    
    function highlightModalStars(rating) {
        document.querySelectorAll('#modalStarRating .star-input').forEach((star, index) => {
            star.classList.toggle('active', index < rating);
        });
    }
    
    function saveCollaborativeResponse() {
        const response = document.getElementById('modalCollabResponse').value.trim();
        const rating = modalStarRating;
        
        if (!rating && !response) {
            alert('Please provide either a rating or response.');
            return;
        }
        
        const saveBtn = document.getElementById('saveCollabResponseBtn');
        const originalText = saveBtn.innerHTML;
        
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
        
        const formData = new FormData();
        formData.append('pdrId', pdrId);
        formData.append('questionId', currentQuestionId);
        formData.append('response', response);
        if (rating) formData.append('rating', rating);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        
        fetch('@Url.Action("SaveCollaborativeResponse", "PDRs", new { area = "PDRs" })', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Close modal
                bootstrap.Modal.getInstance(document.getElementById('collabModal')).hide();
                
                // Refresh the page to show updated data
                window.location.reload();
            } else {
                alert('Error saving response: ' + (data.message || 'Unknown error'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error saving response. Please try again.');
        })
        .finally(() => {
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalText;
        });
    }
    
    // Smart Targets functionality
    let smartTargetCount = 0;
    const smartTargetsContainer = document.getElementById('smartTargetsContainer');
    const addSmartTargetBtn = document.getElementById('addSmartTargetBtn');
    
    if (addSmartTargetBtn) {
        addSmartTargetBtn.addEventListener('click', function() {
            addSmartTarget();
        });
    }
    
    function addSmartTarget(existingTarget = null) {
        smartTargetCount++;
        const targetId = existingTarget ? existingTarget.id : `new_${smartTargetCount}`;
        
        const targetHtml = `
            <div class="smart-target-card" data-target-id="${targetId}">
                <div class="smart-target-header">
                    <h5 class="smart-target-title">
                        <i class="bi bi-bullseye me-2"></i>SMART Target ${smartTargetCount}
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-danger remove-target-btn">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Target Title</label>
                    <input type="text" class="form-control smart-target-title-input" placeholder="Enter a clear, specific target title..." value="${existingTarget ? existingTarget.title : ''}">
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Target Date</label>
                        <input type="date" class="form-control smart-target-date" value="${existingTarget ? existingTarget.targetDate : ''}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select class="form-select smart-target-category">
                            <option value="Performance">Performance</option>
                            <option value="Development">Development</option>
                            <option value="Wellbeing">Wellbeing</option>
                            <option value="Skills">Skills</option>
                            <option value="Leadership">Leadership</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">SMART Target Details</label>
                    <div class="position-relative">
                        <textarea class="form-control smart-target-details" rows="4" placeholder="Describe the target including how success will be measured and key steps to achieve it...">${existingTarget ? (existingTarget.successCriteria || '') + (existingTarget.actionPlan ? '\n' + existingTarget.actionPlan : '') : ''}</textarea>
                        <button type="button" class="btn btn-sm btn-outline-primary enhance-ai-btn" title="Enhance with AI">
                            <i class="bi bi-magic"></i> Enhance with AI
                        </button>
                    </div>
                </div>
            </div>
        `;
        
        const targetElement = document.createElement('div');
        targetElement.innerHTML = targetHtml;
        const targetCard = targetElement.firstElementChild;
        smartTargetsContainer.appendChild(targetCard);
        
        // Add remove functionality
        const removeBtn = targetCard.querySelector('.remove-target-btn');
        if (removeBtn) {
            removeBtn.addEventListener('click', function() {
                if (smartTargetsContainer.children.length > 1 || confirm('Are you sure you want to remove this target?')) {
                    targetCard.remove();
                    updateTargetNumbers();
                    validateSmartTargets();
                }
            });
        }
        
        // Add validation listeners
        const inputs = targetCard.querySelectorAll('input, textarea, select');
        inputs.forEach(input => {
            input.addEventListener('change', validateSmartTargets);
            input.addEventListener('input', validateSmartTargets);
        });
        
        // Add enhance with AI functionality
        const enhanceBtn = targetCard.querySelector('.enhance-ai-btn');
        const detailsTextarea = targetCard.querySelector('.smart-target-details');
        
        enhanceBtn.addEventListener('click', async function() {
            const currentText = detailsTextarea.value.trim();
            
            if (!currentText) {
                alert('Please enter some target details first before enhancing.');
                return;
            }
            
            // Disable button and show loading
            enhanceBtn.disabled = true;
            const originalHtml = enhanceBtn.innerHTML;
            enhanceBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enhancing...';
            
            try {
                const response = await fetch('@Url.Action("EnhanceSmartTarget", "PDRs", new { area = "PDRs" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ target: currentText })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Show confirmation dialog
                    showEnhancementConfirmation(currentText, data.enhancedTarget, (confirmed) => {
                        if (confirmed) {
                            detailsTextarea.value = data.enhancedTarget;
                            validateSmartTargets();
                            
                            // Add a subtle animation to show the text has been updated
                            detailsTextarea.style.backgroundColor = 'rgba(0, 133, 99, 0.1)';
                            setTimeout(() => {
                                detailsTextarea.style.backgroundColor = '';
                            }, 1000);
                        }
                    });
                } else {
                    alert(data.message || 'Unable to enhance target. Please try again.');
                }
            } catch (error) {
                console.error('Error enhancing target:', error);
                alert('Error connecting to the enhancement service. Please try again.');
            } finally {
                enhanceBtn.disabled = false;
                enhanceBtn.innerHTML = originalHtml;
            }
        });
        
        validateSmartTargets();
    }
    
    function updateTargetNumbers() {
        const targets = smartTargetsContainer.querySelectorAll('.smart-target-card');
        targets.forEach((target, index) => {
            const title = target.querySelector('.smart-target-title');
            title.innerHTML = `<i class="bi bi-bullseye me-2"></i>SMART Target ${index + 1}`;
        });
        smartTargetCount = targets.length;
    }
    
    function validateSmartTargets() {
        const targets = smartTargetsContainer.querySelectorAll('.smart-target-card');
        const completeBtn = document.getElementById('completeCollaborativeBtn');
        const requirement = document.getElementById('smartTargetRequirement');
        
        let validTargets = 0;
        targets.forEach(target => {
            const title = target.querySelector('.smart-target-title-input').value.trim();
            const date = target.querySelector('.smart-target-date').value;
            
            if (title && date) {
                validTargets++;
                target.classList.add('valid');
                target.classList.remove('invalid');
            } else {
                target.classList.add('invalid');
                target.classList.remove('valid');
            }
        });
        
        if (validTargets >= 2) {
            completeBtn.disabled = false;
            requirement.classList.remove('alert-info');
            requirement.classList.add('alert-success');
            requirement.innerHTML = '<i class="bi bi-check-circle me-2"></i><strong>Requirement met!</strong> You have set ' + validTargets + ' valid SMART targets.';
        } else {
            completeBtn.disabled = true;
            requirement.classList.remove('alert-success');
            requirement.classList.add('alert-info');
            requirement.innerHTML = '<i class="bi bi-info-circle me-2"></i><strong>Minimum 2 SMART targets</strong> must be set before finalizing the PDR. Currently: ' + validTargets + ' valid targets.';
        }
    }
    
    function getSmartTargetsData() {
        const targets = [];
        const targetCards = smartTargetsContainer.querySelectorAll('.smart-target-card');
        
        targetCards.forEach((card, index) => {
            const details = card.querySelector('.smart-target-details').value.trim();
            const target = {
                title: card.querySelector('.smart-target-title-input').value.trim(),
                description: '', // Empty since we removed description
                priority: 'Medium', // Default priority since we removed the dropdown
                category: card.querySelector('.smart-target-category').value,
                targetDate: card.querySelector('.smart-target-date').value,
                successCriteria: details, // Combined details go into success criteria
                actionPlan: '', // Empty since we're using combined field
                specific: true, // Default to true since we removed checkboxes
                measurable: true,
                achievable: true,
                relevant: true,
                timeBound: true,
                displayOrder: index
            };
            
            if (target.title && target.targetDate) {
                targets.push(target);
            }
        });
        
        return targets;
    }
    
    // Complete collaborative PDR
    const completeBtn = document.getElementById('completeCollaborativeBtn');
    if (completeBtn) {
        completeBtn.addEventListener('click', function() {
            const completedQuestions = Array.from(document.querySelectorAll('.star-rating-large'))
                .filter(rating => parseInt(rating.dataset.rating) > 0).length;
            
            if (completedQuestions < totalQuestions) {
                if (!confirm(`You have only completed ${completedQuestions} out of ${totalQuestions} questions. Are you sure you want to finalize the PDR?`)) {
                    return;
                }
            }
            
            // Validate smart targets
            const smartTargets = getSmartTargetsData();
            if (smartTargets.length < 2) {
                alert('Please set at least 2 SMART targets before finalizing the PDR.');
                return;
            }
            
            if (confirm('Finalize the PDR? This action cannot be undone and will complete the review process.')) {
                const formData = new FormData();
                formData.append('pdrId', pdrId);
                formData.append('smartTargets', JSON.stringify(smartTargets));
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                
                this.disabled = true;
                this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Finalizing...';
                
                fetch('@Url.Action("CompleteCollaborative", "PDRs", new { area = "PDRs" })', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    if (response.ok) {
                        window.location.href = '@Url.Action("Index", "PDRs", new { area = "PDRs" })';
                    } else {
                        alert('Error finalizing PDR. Please try again.');
                        this.disabled = false;
                        this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Finalize PDR';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error finalizing PDR. Please try again.');
                    this.disabled = false;
                    this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Finalize PDR';
                });
            }
        });
    }
});
</script>

<style>
/* Brand Colors */
