/* Animations */
@@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modern-card {
    animation: fadeInUp 0.4s ease;
}

.table-row {
    animation: fadeInUp 0.3s ease;
}
</style>