@model InfoPoint.Areas.PDRs.Controllers.PDRCompletionViewModel
@{
    ViewData["Title"] = $"{Model.ResponseType} PDR Completion - {Model.PDR.Staff.FullName} ({Model.PDR.Year})";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard" asp-area="">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="PDRs" asp-action="Index">PDRs</a></li>
        <li class="breadcrumb-item active" aria-current="page">Complete PDR</li>
    </ol>
</nav>

<div class="container">
    <!-- Subtle progress indicator at top -->
    <div class="progress-indicator-container">
        <div class="progress-indicator">
            <div class="progress-bar-subtle" id="progressBar" style="width: 0%"></div>
        </div>
        <div class="progress-info">
            <span class="progress-text" id="progressText">Loading...</span>
            <div class="pdr-info">
                <span class="staff-name">@Model.PDR.Staff.FullName</span>
                <span class="pdr-details">@Model.PDR.Year @Model.ResponseType PDR</span>
            </div>
        </div>
    </div>
    
    <h1 class="page-title">@Model.ResponseType Performance Review</h1>

    <form id="pdrForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="pdrId" value="@Model.PDR.Id" />
        <input type="hidden" id="responseType" value="@Model.ResponseType" />
        
        <div class="question-carousel">
            @{
                var questionIndex = 0;
                var allQuestions = new List<(dynamic Question, string Category, int GlobalIndex)>();
                
                foreach (var category in Model.Questions.GroupBy(q => q.Category))
                {
                    foreach (var question in category.OrderBy(q => q.Order))
                    {
                        var shouldShowQuestion = Model.ResponseType == PDRType.Staff || 
                                                (Model.ResponseType == PDRType.Manager && question.HasManagerQuestion);
                        if (shouldShowQuestion)
                        {
                            allQuestions.Add((question, category.Key, questionIndex++));
                        }
                    }
                }
            }
            
            @foreach (var (question, category, index) in allQuestions)
            {
                var existingResponse = Model.Responses.FirstOrDefault(r => r.QuestionId == question.Id && r.ResponseType == Model.ResponseType);
                var questionText = Model.ResponseType == PDRType.Staff ? 
                                 question.StaffQuestionText : 
                                 question.ManagerQuestionText;
                var isFirstInCategory = index == 0 || allQuestions[index - 1].Category != category;
                
                <div class="question-slide" data-question-index="@index" data-question-id="@question.Id" data-category="@category" style="display: @(index == 0 ? "block" : "none")">
                    @if (isFirstInCategory)
                    {
                        <div class="category-intro">
                            <h2 class="category-title">@category</h2>
                            <div class="category-divider"></div>
                        </div>
                    }
                    
                    <div class="question-content">
                        <h3 class="question-text">@questionText</h3>
                        @if (!string.IsNullOrEmpty(question.Description))
                        {
                            <p class="question-description">@question.Description</p>
                        }
                        
                        <div class="rating-section">
                            <div class="star-rating-large" data-question-id="@question.Id" data-rating="@(existingResponse?.Rating ?? 0)">
                                <span class="star-large" data-value="1">★</span>
                                <span class="star-large" data-value="2">★</span>
                                <span class="star-large" data-value="3">★</span>
                                <span class="star-large" data-value="4">★</span>
                                <span class="star-large" data-value="5">★</span>
                            </div>
                            <p class="rating-text-large"></p>
                        </div>
                        
                        <div class="pill-options-container" data-question-id="@question.Id" style="display: none;">
                            <div class="pill-options" data-question-id="@question.Id">
                                <!-- Pills will be populated by JavaScript based on rating -->
                            </div>
                        </div>
                        
                        <div class="response-container-centered" data-question-id="@question.Id" style="display: none;">
                            <p class="add-comment-text">
                                <a href="#" class="add-comment-link" data-question-id="@question.Id">
                                    <i class="bi bi-chat-text me-1"></i>Add a comment (optional)
                                </a>
                            </p>
                            <div class="comment-section" data-question-id="@question.Id" style="display: none;">
                                <textarea class="form-control comment-textarea" 
                                          rows="6" 
                                          placeholder="Share your thoughts..."
                                          data-question-id="@question.Id"></textarea>
                                <div class="save-indicator" data-question-id="@question.Id"></div>
                            </div>
                            <!-- Hidden textarea to store the full response -->
                            <textarea class="response-textarea-large" 
                                      data-question-id="@question.Id" 
                                      style="display: none;">@(existingResponse?.Response ?? "")</textarea>
                        </div>
                    </div>
                    
                    <div class="navigation-buttons">
                        @if (index > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-lg prev-btn" data-target="@(index - 1)">
                                <i class="bi bi-arrow-left me-2"></i>Previous
                            </button>
                        }
                        
                        @if (index < allQuestions.Count - 1)
                        {
                            <button type="button" class="btn btn-primary btn-lg next-btn ms-auto" data-target="@(index + 1)">
                                Next<i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success btn-lg ms-auto" id="reviewBtn">
                                Review & Complete<i class="bi bi-check-circle ms-2"></i>
                            </button>
                        }
                    </div>
                </div>
            }
            
            <div class="question-slide review-slide" data-question-index="review" style="display: none;">
                <div class="review-content">
                    <h2 class="text-center mb-4">Review Your PDR</h2>
                    <div class="review-summary" id="reviewSummary">
                        <!-- Will be populated by JavaScript -->
                    </div>
                    <div class="text-center mt-5">
                        <button type="button" class="btn btn-outline-secondary btn-lg" id="backToQuestionsBtn">
                            <i class="bi bi-arrow-left me-2"></i>Back to Questions
                        </button>
                        <button type="button" class="btn btn-success btn-lg ms-3" id="completePDRBtn">
                            <i class="bi bi-check-circle me-2"></i>Submit @Model.ResponseType PDR
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const pdrId = document.getElementById('pdrId').value;
    const responseType = document.getElementById('responseType').value;
    let currentQuestionIndex = 0;
    const totalQuestions = document.querySelectorAll('.question-slide:not(.review-slide)').length;
    
    // Initialize
    initializeStarRatings();
    initializeNavigation();
    initializeAutoSave();
    initializeCommentLinks();
    initializePillSelections();
    updateProgress();
    
    function initializeStarRatings() {
        document.querySelectorAll('.star-rating-large').forEach(ratingContainer => {
            const questionId = ratingContainer.dataset.questionId;
            const currentRating = parseInt(ratingContainer.dataset.rating) || 0;
            const stars = ratingContainer.querySelectorAll('.star-large');
            const ratingText = ratingContainer.nextElementSibling;
            
            // Set initial rating
            updateStarDisplay(stars, currentRating, ratingText);
            
            stars.forEach((star, index) => {
                const rating = index + 1;
                
                // Hover effects
                star.addEventListener('mouseenter', () => {
                    highlightStars(stars, rating);
                });
                
                star.addEventListener('mouseleave', () => {
                    const currentRating = parseInt(ratingContainer.dataset.rating) || 0;
                    updateStarDisplay(stars, currentRating, ratingText);
                });
                
                // Click to set rating
                star.addEventListener('click', () => {
                    ratingContainer.dataset.rating = rating;
                    updateStarDisplay(stars, rating, ratingText);
                    
                    // Show pill options based on rating
                    showPillOptions(questionId, rating);
                    
                    // Show the response container but keep comment section hidden
                    const responseContainer = document.querySelector(`.response-container-centered[data-question-id="${questionId}"]`);
                    if (responseContainer) {
                        responseContainer.style.display = 'block';
                        responseContainer.classList.add('fade-in');
                    }
                    
                    saveResponse(questionId);
                });
            });
        });
    }
    
    function initializeNavigation() {
        // Previous buttons
        document.querySelectorAll('.prev-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const targetIndex = parseInt(this.dataset.target);
                navigateToQuestion(targetIndex);
            });
        });
        
        // Next buttons
        document.querySelectorAll('.next-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const currentSlide = document.querySelector('.question-slide[style*="block"]');
                const questionId = currentSlide.dataset.questionId;
                
                // Check if rating is selected
                const rating = document.querySelector(`.star-rating-large[data-question-id="${questionId}"]`).dataset.rating;
                if (!rating || rating === '0') {
                    showValidationMessage(questionId, 'Please select a rating before proceeding');
                    return;
                }
                
                // Check if at least one pill is selected
                const selectedPills = document.querySelectorAll(`.pill-options[data-question-id="${questionId}"] .feedback-pill.active`);
                if (selectedPills.length === 0) {
                    showValidationMessage(questionId, 'Please select at least one feedback option before proceeding');
                    return;
                }
                
                const targetIndex = parseInt(this.dataset.target);
                navigateToQuestion(targetIndex);
            });
        });
        
        // Review button
        const reviewBtn = document.getElementById('reviewBtn');
        if (reviewBtn) {
            reviewBtn.addEventListener('click', function() {
                const currentSlide = document.querySelector('.question-slide[style*="block"]');
                const questionId = currentSlide.dataset.questionId;
                
                // Check if rating is selected
                const rating = document.querySelector(`.star-rating-large[data-question-id="${questionId}"]`).dataset.rating;
                if (!rating || rating === '0') {
                    showValidationMessage(questionId, 'Please select a rating before proceeding');
                    return;
                }
                
                // Check if at least one pill is selected
                const selectedPills = document.querySelectorAll(`.pill-options[data-question-id="${questionId}"] .feedback-pill.active`);
                if (selectedPills.length === 0) {
                    showValidationMessage(questionId, 'Please select at least one feedback option before proceeding');
                    return;
                }
                
                showReviewPage();
            });
        }
        
        // Back to questions from review
        const backBtn = document.getElementById('backToQuestionsBtn');
        if (backBtn) {
            backBtn.addEventListener('click', function() {
                navigateToQuestion(totalQuestions - 1);
            });
        }
    }
    
    function initializeAutoSave() {
        // Handle comment textareas separately
        document.querySelectorAll('.comment-textarea').forEach(textarea => {
            let saveTimer;
            
            textarea.addEventListener('input', function() {
                clearTimeout(saveTimer);
                const questionId = this.dataset.questionId;
                const indicator = document.querySelector(`.save-indicator[data-question-id="${questionId}"]`);
                
                if (indicator) {
                    indicator.innerHTML = '<small class="text-muted">Typing...</small>';
                }
                
                saveTimer = setTimeout(() => {
                    updateFullResponse(questionId);
                    saveResponse(questionId);
                }, 1000);
            });
            
            textarea.addEventListener('blur', function() {
                clearTimeout(saveTimer);
                updateFullResponse(this.dataset.questionId);
                saveResponse(this.dataset.questionId);
            });
        });
    }
    
    function updateFullResponse(questionId) {
        const selectedPills = Array.from(
            document.querySelectorAll(`.pill-options[data-question-id="${questionId}"] .feedback-pill.active`)
        ).map(pill => pill.textContent);
        
        const commentTextarea = document.querySelector(`.comment-textarea[data-question-id="${questionId}"]`);
        const comment = commentTextarea ? commentTextarea.value.trim() : '';
        
        let fullResponse = '';
        
        if (selectedPills.length > 0) {
            fullResponse = 'Selected feedback: ' + selectedPills.join(', ');
            if (comment) {
                fullResponse += '\nAdditional comment: ' + comment;
            }
        } else if (comment) {
            fullResponse = 'Additional comment: ' + comment;
        }
        
        // Update the hidden response textarea
        const responseTextarea = document.querySelector(`.response-textarea-large[data-question-id="${questionId}"]`);
        if (responseTextarea) {
            responseTextarea.value = fullResponse;
        }
    }
    
    function navigateToQuestion(index) {
        // Hide all slides
        document.querySelectorAll('.question-slide').forEach(slide => {
            slide.style.display = 'none';
            slide.classList.remove('slide-in-right', 'slide-in-left');
        });
        
        // Show target slide with animation
        const targetSlide = document.querySelector(`[data-question-index="${index}"]`);
        if (targetSlide) {
            targetSlide.style.display = 'block';
            
            // Add animation class based on direction
            if (index > currentQuestionIndex) {
                targetSlide.classList.add('slide-in-right');
            } else {
                targetSlide.classList.add('slide-in-left');
            }
            
            currentQuestionIndex = index;
            updateProgress();
        }
    }
    
    function showReviewPage() {
        // Hide all question slides
        document.querySelectorAll('.question-slide').forEach(slide => {
            slide.style.display = 'none';
        });
        
        // Populate review summary
        const summaryDiv = document.getElementById('reviewSummary');
        let summaryHTML = '';
        let currentCategory = '';
        
        document.querySelectorAll('.question-slide:not(.review-slide)').forEach((slide, index) => {
            const questionId = slide.dataset.questionId;
            const category = slide.dataset.category;
            const questionText = slide.querySelector('.question-text').textContent;
            const rating = document.querySelector(`.star-rating-large[data-question-id="${questionId}"]`).dataset.rating || 0;
            const response = document.querySelector(`.response-textarea-large[data-question-id="${questionId}"]`).value.trim();
            
            if (category !== currentCategory) {
                if (currentCategory !== '') {
                    summaryHTML += '</div>';
                }
                summaryHTML += `<div class="category-section"><h4>${category}</h4>`;
                currentCategory = category;
            }
            
            // Parse the response to separate pills and comments
            let pillText = '';
            let commentText = '';
            if (response) {
                const pillMatch = response.match(/Selected feedback: (.*?)(?:\n|$)/);
                const commentMatch = response.match(/Additional comment: (.*)/s);
                if (pillMatch) pillText = pillMatch[1];
                if (commentMatch) commentText = commentMatch[1];
            }
            
            summaryHTML += `
                <div class="review-item ${rating > 0 ? 'completed' : 'incomplete'}">
                    <p class="review-question">${questionText}</p>
                    <div class="review-rating">Rating: ${rating > 0 ? '★'.repeat(rating) : 'Not rated'}</div>
                    ${pillText ? `<div class="review-pills"><strong>Feedback:</strong> ${pillText}</div>` : ''}
                    ${commentText ? `<div class="review-comment"><strong>Comment:</strong> ${commentText}</div>` : ''}
                    ${!pillText && !commentText && rating > 0 ? '<em>No additional feedback provided</em>' : ''}
                </div>
            `;
        });
        
        if (currentCategory !== '') {
            summaryHTML += '</div>';
        }
        
        summaryDiv.innerHTML = summaryHTML;
        
        // Show review slide
        document.querySelector('.review-slide').style.display = 'block';
        document.querySelector('.review-slide').classList.add('fade-in');
    }
    
    function highlightStars(stars, rating) {
        stars.forEach((star, index) => {
            star.classList.toggle('active', index < rating);
        });
    }
    
    function updateStarDisplay(stars, rating, ratingText) {
        highlightStars(stars, rating);
        
        const ratingLabels = ['', 'Poor', 'Below Average', 'Average', 'Good', 'Excellent'];
        if (ratingText) {
            ratingText.textContent = rating > 0 ? `${ratingLabels[rating]}` : '';
        }
    }
    
    function saveResponse(questionId) {
        const responseTextarea = document.querySelector(`.response-textarea-large[data-question-id="${questionId}"]`);
        const starRating = document.querySelector(`.star-rating-large[data-question-id="${questionId}"]`);
        const indicator = document.querySelector(`.save-indicator[data-question-id="${questionId}"]`);
        
        const response = responseTextarea ? responseTextarea.value.trim() : '';
        const rating = starRating ? parseInt(starRating.dataset.rating) || null : null;
        
        // Don't save if neither rating nor response is provided
        if (!rating && !response) {
            return;
        }
        
        if (indicator) {
            indicator.innerHTML = '<small class="text-info">Saving...</small>';
        }
        
        const formData = new FormData();
        formData.append('pdrId', pdrId);
        formData.append('questionId', questionId);
        formData.append('responseType', responseType);
        formData.append('response', response);
        if (rating) formData.append('rating', rating);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        
        fetch('@Url.Action("SaveResponse", "PDRs", new { area = "PDRs" })', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                if (indicator) {
                    indicator.innerHTML = '<small class="text-success"><i class="bi bi-check-circle"></i> Saved</small>';
                    setTimeout(() => {
                        indicator.innerHTML = '';
                    }, 3000);
                }
                updateProgress();
            } else {
                if (indicator) {
                    indicator.innerHTML = '<small class="text-danger">Error saving</small>';
                }
            }
        })
        .catch(error => {
            console.error('Error:', error);
            if (indicator) {
                indicator.innerHTML = '<small class="text-danger">Error saving</small>';
            }
        });
    }
    
    function updateProgress() {
        const completedQuestions = Array.from(document.querySelectorAll('.star-rating-large'))
            .filter(rating => parseInt(rating.dataset.rating) > 0).length;
        
        const percentage = Math.round((completedQuestions / totalQuestions) * 100);
        
        document.getElementById('progressBar').style.width = percentage + '%';
        
        const currentSlideNum = currentQuestionIndex + 1;
        document.getElementById('progressText').textContent = 
            currentQuestionIndex === 'review' 
                ? 'Review' 
                : `Question ${currentSlideNum} of ${totalQuestions}`;
    }
    
    function showPillOptions(questionId, rating) {
        const pillContainer = document.querySelector(`.pill-options-container[data-question-id="${questionId}"]`);
        const pillOptionsDiv = document.querySelector(`.pill-options[data-question-id="${questionId}"]`);
        
        if (!pillContainer || !pillOptionsDiv) return;
        
        // Define pill options based on rating
        let pillOptions = [];
        
        if (rating >= 4) {
            // 4-5 stars: Positive options
            pillOptions = [
                'Exceeding expectations',
                'Very supportive',
                'Great work-life balance',
                'Feeling motivated',
                'Clear goals',
                'Strong team collaboration',
                'Excellent progress',
                'Well-resourced'
            ];
        } else if (rating === 3) {
            // 3 stars: Neutral options
            pillOptions = [
                'Meeting expectations',
                'Adequate support',
                'Room for improvement',
                'Steady progress',
                'Some challenges',
                'Managing workload',
                'Need clarity',
                'Developing skills'
            ];
        } else {
            // 1-2 stars: Areas for improvement
            pillOptions = [
                'Need more support',
                'Feeling overwhelmed',
                'Unclear expectations',
                'Limited resources',
                'Communication gaps',
                'Heavy workload',
                'Skill development needed',
                'Seeking guidance'
            ];
        }
        
        // Clear existing pills
        pillOptionsDiv.innerHTML = '';
        
        // Add pills
        pillOptions.forEach(option => {
            const pill = document.createElement('span');
            pill.className = 'feedback-pill';
            pill.textContent = option;
            pill.dataset.questionId = questionId;
            pill.addEventListener('click', function() {
                this.classList.toggle('active');
                updateSelectedPills(questionId);
            });
            pillOptionsDiv.appendChild(pill);
        });
        
        // Show container with animation
        pillContainer.style.display = 'block';
        pillContainer.classList.add('fade-in');
        
        // Check if we have existing selections
        const existingResponse = document.querySelector(`.response-textarea-large[data-question-id="${questionId}"]`);
        if (existingResponse && existingResponse.value) {
            // Try to match existing response with pills
            const responseText = existingResponse.value.toLowerCase();
            pillOptionsDiv.querySelectorAll('.feedback-pill').forEach(pill => {
                if (responseText.includes(pill.textContent.toLowerCase())) {
                    pill.classList.add('active');
                }
            });
        }
    }
    
    function updateSelectedPills(questionId) {
        updateFullResponse(questionId);
        saveResponse(questionId);
    }
    
    function initializeCommentLinks() {
        document.querySelectorAll('.add-comment-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const questionId = this.dataset.questionId;
                const commentSection = document.querySelector(`.comment-section[data-question-id="${questionId}"]`);
                
                if (commentSection) {
                    if (commentSection.style.display === 'none') {
                        commentSection.style.display = 'block';
                        commentSection.classList.add('fade-in');
                        const textarea = commentSection.querySelector('textarea');
                        if (textarea) {
                            setTimeout(() => textarea.focus(), 100);
                        }
                        this.innerHTML = '<i class="bi bi-chat-text-fill me-1"></i>Hide comment';
                    } else {
                        commentSection.style.display = 'none';
                        this.innerHTML = '<i class="bi bi-chat-text me-1"></i>Add a comment (optional)';
                    }
                }
            });
        });
    }
    
    function initializePillSelections() {
        // Handle any pre-existing ratings
        document.querySelectorAll('.star-rating-large').forEach(ratingContainer => {
            const rating = parseInt(ratingContainer.dataset.rating);
            if (rating > 0) {
                const questionId = ratingContainer.dataset.questionId;
                showPillOptions(questionId, rating);
                
                // Show response container if rating exists
                const responseContainer = document.querySelector(`.response-container-centered[data-question-id="${questionId}"]`);
                if (responseContainer) {
                    responseContainer.style.display = 'block';
                    
                    // Check if there's a comment in the response
                    const responseTextarea = responseContainer.querySelector('.response-textarea-large');
                    if (responseTextarea && responseTextarea.value) {
                        const commentMatch = responseTextarea.value.match(/Additional comment: (.*)/s);
                        if (commentMatch && commentMatch[1]) {
                            const commentTextarea = responseContainer.querySelector('.comment-textarea');
                            const commentSection = responseContainer.querySelector('.comment-section');
                            const addCommentLink = responseContainer.querySelector('.add-comment-link');
                            
                            if (commentTextarea && commentSection && addCommentLink) {
                                commentTextarea.value = commentMatch[1];
                                commentSection.style.display = 'block';
                                addCommentLink.innerHTML = '<i class="bi bi-chat-text-fill me-1"></i>Hide comment';
                            }
                        }
                    }
                }
            }
        });
    }
    
    function showValidationMessage(questionId, message) {
        // Remove any existing validation messages
        document.querySelectorAll('.validation-message').forEach(msg => msg.remove());
        
        // Create and show new validation message
        const questionSlide = document.querySelector(`.question-slide[data-question-id="${questionId}"]`);
        if (questionSlide) {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'validation-message alert alert-warning fade-in';
            messageDiv.innerHTML = `<i class="bi bi-exclamation-circle me-2"></i>${message}`;
            
            // Insert after the pill options or rating section
            const pillContainer = questionSlide.querySelector('.pill-options-container');
            const ratingSection = questionSlide.querySelector('.rating-section');
            
            if (pillContainer && pillContainer.style.display !== 'none') {
                pillContainer.after(messageDiv);
            } else if (ratingSection) {
                ratingSection.after(messageDiv);
            }
            
            // Auto-hide after 5 seconds
            setTimeout(() => {
                messageDiv.classList.add('fade-out');
                setTimeout(() => messageDiv.remove(), 300);
            }, 5000);
        }
    }
    
    // Complete PDR
    document.getElementById('completePDRBtn').addEventListener('click', function() {
        const completedQuestions = Array.from(document.querySelectorAll('.star-rating-large'))
            .filter(rating => parseInt(rating.dataset.rating) > 0).length;
        
        if (completedQuestions < totalQuestions) {
            if (!confirm(`You have only completed ${completedQuestions} out of ${totalQuestions} questions. Are you sure you want to submit the PDR?`)) {
                return;
            }
        }
        
        if (confirm(`Submit your ${responseType} PDR? This action cannot be undone.`)) {
            const formData = new FormData();
            formData.append('pdrId', pdrId);
            formData.append('responseType', responseType);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
            
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';
            
            fetch('@Url.Action("CompletePDR", "PDRs", new { area = "PDRs" })', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '@Url.Action("Index", "PDRs", new { area = "PDRs" })';
                } else {
                    alert('Error completing PDR. Please try again.');
                    this.disabled = false;
                    this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Submit ' + responseType + ' PDR';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error completing PDR. Please try again.');
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Submit ' + responseType + ' PDR';
            });
        }
    });
});
</script>

