@{
    ViewData["Title"] = "Welcome";
}

<div class="jumbotron text-center">
    <h1 class="display-4">Welcome to InfoPoint</h1>
    <p class="lead">Staff Management System for Learning Walks and Performance Development Reviews</p>
    
    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <hr class="my-4">
        <p>Please sign in with your BDC staff account to continue.</p>
        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" role="button">
            <i class="bi bi-box-arrow-in-right"></i> Sign In
        </a>
        <p class="mt-3"><small class="text-muted">Access restricted to @@g.bdc.ac.uk email addresses only</small></p>
    }
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-clipboard-check"></i> Learning Walks
                </h5>
                <p class="card-text">
                    Streamline your classroom observation process with our comprehensive Learning Walks management system.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-person-badge"></i> Performance Development Reviews
                </h5>
                <p class="card-text">
                    Manage staff PDRs efficiently with our integrated performance review and objective tracking system.
                </p>
            </div>
        </div>
    </div>
</div>
