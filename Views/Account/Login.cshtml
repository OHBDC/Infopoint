@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">InfoPoint Login</h2>
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @TempData["ErrorMessage"]
                    </div>
                }
                
                <div class="text-center">
                    <p class="mb-4">Sign in with your BDC staff account</p>
                    
                    <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="form-horizontal">
                        <input type="hidden" name="provider" value="Google" />
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-google"></i> Sign in with Google
                        </button>
                    </form>
                    
                    <div class="mt-4">
                        <small class="text-muted">Only @@g.bdc.ac.uk email addresses are allowed</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>