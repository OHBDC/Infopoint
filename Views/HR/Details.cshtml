@model InfoPoint.Models.StaffHR

@{
    ViewData["Title"] = "Staff Details";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">Staff Details</h1>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">@Model.FullName</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Employee Number</dt>
                        <dd class="col-sm-8">@Model.EmployeeNumber</dd>

                        <dt class="col-sm-4">Job Title</dt>
                        <dd class="col-sm-8">@Model.JobTitle</dd>

                        <dt class="col-sm-4">Contract Type</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.ContractType</span>
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <h5>Organizational Hierarchy</h5>
                    <dl class="row">
                        @if (!string.IsNullOrEmpty(Model.HierarchyLevel1))
                        {
                            <dt class="col-sm-4">Level 1</dt>
                            <dd class="col-sm-8">@Model.HierarchyLevel1</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.HierarchyLevel2))
                        {
                            <dt class="col-sm-4">Level 2</dt>
                            <dd class="col-sm-8">@Model.HierarchyLevel2</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.HierarchyLevel3))
                        {
                            <dt class="col-sm-4">Level 3</dt>
                            <dd class="col-sm-8">@Model.HierarchyLevel3</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.HierarchyLevel4))
                        {
                            <dt class="col-sm-4">Level 4</dt>
                            <dd class="col-sm-8">@Model.HierarchyLevel4</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.HierarchyLevel5))
                        {
                            <dt class="col-sm-4">Level 5</dt>
                            <dd class="col-sm-8">@Model.HierarchyLevel5</dd>
                        }
                    </dl>

                    <hr />

                    <h5>Manager Information</h5>
                    <dl class="row">
                        @if (!string.IsNullOrEmpty(Model.ManagerName))
                        {
                            <dt class="col-sm-4">Manager Name</dt>
                            <dd class="col-sm-8">@Model.ManagerName</dd>
                        }
                        @if (Model.ManagerEmployeeNumber.HasValue)
                        {
                            <dt class="col-sm-4">Manager Employee Number</dt>
                            <dd class="col-sm-8">@Model.ManagerEmployeeNumber</dd>
                        }
                    </dl>

                    @if (Model.StaffAD != null)
                    {
                        <hr />
                        <h5>Active Directory Information</h5>
                        <dl class="row">
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.StaffAD.Email</dd>

                            <dt class="col-sm-4">AD First Name</dt>
                            <dd class="col-sm-8">@Model.StaffAD.FirstName</dd>

                            <dt class="col-sm-4">AD Last Name</dt>
                            <dd class="col-sm-8">@Model.StaffAD.LastName</dd>

                            <dt class="col-sm-4">AD Department</dt>
                            <dd class="col-sm-8">@Model.StaffAD.Area</dd>

                            <dt class="col-sm-4">AD Job Title</dt>
                            <dd class="col-sm-8">@Model.StaffAD.JobTitle</dd>

                            <dt class="col-sm-4">AD Status</dt>
                            <dd class="col-sm-8">
                                @if (Model.StaffAD.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Inactive</span>
                                }
                            </dd>
                        </dl>
                    }
                    else
                    {
                        <hr />
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            This staff member is not found in Active Directory or the AD sync data.
                        </div>
                    }

                    <hr />

                    <h5>Record Information</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Created Date</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        @if (Model.LastUpdated.HasValue)
                        {
                            <dt class="col-sm-4">Last Updated</dt>
                            <dd class="col-sm-8">@Model.LastUpdated.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
