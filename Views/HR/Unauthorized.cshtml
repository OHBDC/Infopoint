@{
    ViewData["Title"] = "Unauthorized Access";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Unauthorized Access
                    </h4>
                </div>
                <div class="card-body text-center py-5">
                    <i class="bi bi-lock-fill text-danger" style="font-size: 4rem;"></i>
                    <h2 class="mt-3">Access Denied</h2>
                    <p class="lead">You do not have permission to access the HR Management system.</p>
                    <p class="text-muted">
                        Only authorized HR personnel can access this area. If you believe you should have access,
                        please contact your system administrator.
                    </p>
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> Return to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
